---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import Post from '~/components/Post.astro'
import { getPosts, getPostDescription } from '~/utils'
import Pagination from '~/components/Pagination.astro'

const posts = (await getPosts()).slice(0, 5)

const { translate: t } = Astro.locals

---

<LayoutDefault>
  <section contain-layout un-flex="~ col gap-6 md:gap-7.5 lg:gap-7.5">
    {
      posts.map((post) => (
        <Post post={post}>
          <p class="line-clamp-2 sm:line-clamp-3 md:line-clamp-4">{getPostDescription(post)}</p>
        </Post>
      ))
    }
    <Pagination showLeft={false} showPageCount={false} rightTitle={t('all_posts')} rightUrl={'posts/page/1'} />
  </section>
  
  <!-- 结构化数据 -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "斑猫",
    "description": "Rediscory the beauty of typography",
    "url": "${Astro.site?.href}",
    "publisher": {
      "@type": "Organization",
      "name": "斑猫",
      "logo": {
        "@type": "ImageObject",
        "url": "${Astro.site?.href}favicon.svg",
        "width": 32,
        "height": 32
      }
    },
    "mainEntity": [
      ${posts.map((post, index) => `{
        "@type": "BlogPosting",
        "headline": "${post.data.title}",
        "url": "${Astro.site?.href}posts/${post.slug}",
        "datePublished": "${post.data.pubDate.toISOString()}",
        "author": {
          "@type": "Person",
          "name": "${post.data.author || 'Maculosa'}"
        }
      }`).join(',\n      ')}
    ]
  }
  </script>
</LayoutDefault>
