---
import { formatDate, getPathFromCategory } from '~/utils'
import { THEME_CONFIG } from '~/theme.config'
import type { Post } from '~/types'
interface Props {
  post: Post
  collection?: string
}

const { post, collection = "posts" } = Astro.props
const { translate: t } = Astro.locals

function getCategoryUrl(category: string) {
  return `/categories/${getPathFromCategory(category, THEME_CONFIG.category_map)}`
}
---

<article class="heti">
  <header>
    <h1 class="post-title! text-2xl md:text-3xl lg:text-4xl">
      <a href={`/${collection}/${post.slug}/`}>{post.data.title}</a>
    </h1>
    <div class="mt-2 text-xs md:text-sm lg:text-base">
      <span>{t('posted_at')}</span>
      <time>{formatDate(post.data.pubDate)}</time>
      {
        post.data.categories &&
          post.data.categories.map((category) => (
            <a class="ml-1 md:ml-2.5 text-xs md:text-sm" href={getCategoryUrl(category)}>
              # {category}
            </a>
          ))
      }
    </div>
  </header>
  <slot />
</article>
